{
	"name": "map-making-app",
	"private": true,
	"version": "0.10.4",
	"type": "module",
	"engines": {
		"node": "^24.15.0"
	},
	"scripts": {
		"gen:plugin-types": "node ../plugins/types/generate.js",
		"typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.procedures.json && tsc --noEmit -p test/tsconfig.json",
		"gen:plugin-registry": "node ../plugins/generate-registry.js",
		"gen:image-dims": "node scripts/gen-image-dims.mjs",
		"gen:i18n": "node scripts/i18n-extract.mjs",
		"i18n:missing": "node scripts/i18n-extract.mjs --missing",
		"gen:bindings": "cargo run --manifest-path src-tauri/Cargo.toml -- --export-bindings",
		"proto:gen": "pbf src/lib/proto/getmetadata.proto > src/lib/proto/getmetadata.gen.js && node scripts/gen-proto-array.mjs src/lib/proto/getmetadata.proto > src/lib/proto/getmetadata.array.gen.ts",
		"dev": "vite",
		"build:procedures": "node scripts/build-procedures.mjs",
		"build": "npm run gen:plugin-types && npm run gen:plugin-registry && npm run gen:image-dims && npm run gen:i18n && npm run build:procedures && vite build",
		"build:opensv": "node opensv-build/build-opensv.mjs",
		"format": "prettier --write --ignore-path ../.prettierignore \"src/**/*.{ts,tsx,css,json}\" \"test/**/*.{ts,tsx}\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
		"lint": "eslint .",
		"preview": "vite preview",
		"test": "vitest run && npm run test:procedures",
		"test:procedures": "npm run build:procedures && node --test procedures/*/test/*.test.mjs ../plugins/*/test/*.test.mjs",
		"test:watch": "vitest",
		"test:integration": "vitest run -c vitest.integration.config.ts",
		"bench": "vitest bench --run",
		"build:e2e": "cargo tauri build --debug --features e2e",
		"test:e2e": "wdio run wdio.conf.ts",
		"prepare": "husky || true"
	},
	"dependencies": {
		"@base-ui-components/react": "1.0.0-rc.0",
		"@deck.gl/core": "~9.3.11",
		"@deck.gl/extensions": "~9.3.11",
		"@deck.gl/google-maps": "~9.3.11",
		"@deck.gl/layers": "~9.3.11",
		"@deck.gl/mapbox": "~9.3.11",
		"@luma.gl/core": "9.3.6",
		"@luma.gl/engine": "9.3.6",
		"@luma.gl/shadertools": "9.3.6",
		"@luma.gl/webgl": "9.3.6",
		"@luma.gl/webgpu": "9.3.6",
		"@mdi/js": "^7.4.47",
		"@photostructure/tz-lookup": "^11.6.1",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-visually-hidden": "^1.2.11",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.3",
		"@tauri-apps/plugin-log": "^2.9.1",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-shell": "^2.3.6",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"maplibre-gl": "^6.7.0",
		"pbf": "^5.1.2",
		"react": "^19.2.8",
		"react-colorful": "^5.8.1",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.8",
		"ts-pattern": "^5.9.0"
	},
	"lint-staged": {
		"*.{ts,tsx}": [
			"prettier --write --ignore-path ../.prettierignore",
			"eslint --fix"
		],
		"*.{json,css,md}": "prettier --write --ignore-path ../.prettierignore"
	},
	"pnpm": {
		"overrides": {
			"@luma.gl/core": "9.3.6",
			"@luma.gl/engine": "9.3.6",
			"@luma.gl/shadertools": "9.3.6",
			"@luma.gl/webgl": "9.3.6",
			"@luma.gl/webgpu": "9.3.6",
			"@luma.gl/gpgpu": "9.3.6"
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@mdn/browser-compat-data": "^8.1.0",
		"@mdx-js/rollup": "^3.1.1",
		"@tauri-apps/cli": "^2.11.4",
		"@types/google.maps": "^3.66.2",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@typescript/native": "npm:typescript@~7.0.2",
		"@vitejs/plugin-react": "^6.1.1",
		"@wdio/cli": "^9.31.6",
		"@wdio/local-runner": "^9.31.6",
		"@wdio/mocha-framework": "^9.31.6",
		"@wdio/spec-reporter": "^9.31.2",
		"@wdio/types": "^9.31.2",
		"esbuild": "^0.28.2",
		"eslint": "^10.10.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.6",
		"fast-check": "^4.9.0",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"image-size": "^2.0.2",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.5.0",
		"prettier": "^3.9.6",
		"react-scan": "^0.5.7",
		"rollup": "^4.63.1",
		"rollup-plugin-dts": "^6.5.1",
		"terser": "^5.51.2",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"webdriverio": "^9.31.6"
	}
}
